# Keep this file as a template. Put real secrets in .env, which is git-ignored.
# Codex uses the existing `codex login` session by default.
CODEX_PATH=
CODEX_MODEL=

# Optional fallback when Codex is not authenticated.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_SAFETY_IDENTIFIER=
API_PORT=4176
DASHBOARD_ORIGINS=http://127.0.0.1:4175,http://localhost:4175

# Optional: adds region-aware movie/series availability from TMDB + JustWatch.
# Create a TMDB API Read Access Token; it remains in this server-side file.
TMDB_READ_ACCESS_TOKEN=
TMDB_REGION=US
